# Optional S3-compatible shared cloud storage (AWS S3, Cloudflare R2, DigitalOcean Spaces, etc.)
# Leave these unset to use the local server storage used by the development preview.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Required only for providers with a custom endpoint, such as Cloudflare R2.
S3_ENDPOINT=

# Optional production overrides. Otherwise server/data/auth.json is used.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Public origin used by the deployed site, for example https://admin.example.com
PUBLIC_ORIGIN=
API_PORT=8787
