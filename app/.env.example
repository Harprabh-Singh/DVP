# Vercel Blob is used automatically by the serverless deployment.
# Connecting a Blob store in Vercel normally adds this variable for you.
BLOB_READ_WRITE_TOKEN=

# Optional S3-compatible storage for the standalone Node server.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Required only for providers with a custom endpoint, such as Cloudflare R2.
S3_ENDPOINT=

# Optional production overrides. Otherwise server/data/auth.json is used.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Public origin used by the deployed site, for example https://admin.example.com
PUBLIC_ORIGIN=
API_PORT=8787
